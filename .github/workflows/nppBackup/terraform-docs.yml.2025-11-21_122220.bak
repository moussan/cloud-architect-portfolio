name: Terraform Docs

on:
  workflow_dispatch:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  generate-docs:
    name: Generate terraform-docs
    runs-on: ubuntu-latest

    strategy:
      matrix:
        project:
          - projects/01-ha-web-app/terraform
          - projects/02-serverless-pipeline/terraform
          - projects/03-landing-zone/terraform
          - projects/04-eks-application-deployment/terraform
          - projects/05-hybrid-cloud-architecture/terraform
          - projects/06-data-lake/terraform

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # This single action call runs terraform-docs for each module
      - name: Generate docs for ${{ matrix.project }}
        uses: terraform-docs/gh-actions@v1.4.1
        with:
          working-dir: ${{ matrix.project }}
          # Write docs into TF_DOCS.md in each terraform folder
          output-file: TF_DOCS.md
          output-method: replace
          # no git-push, no config-file, no output-format – keep it simple

      # Optional: collect all generated docs as an artifact
      - name: Upload terraform-docs artifacts
        if: matrix.project == 'projects/06-data-lake/terraform'
        uses: actions/upload-artifact@v4
        with:
          name: terraform-docs
          path: projects/**/TF_DOCS.md
