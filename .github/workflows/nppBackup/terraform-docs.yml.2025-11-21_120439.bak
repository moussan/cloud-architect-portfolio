name: Terraform Docs

on:
  workflow_dispatch:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  generate-docs:
    name: Generate terraform-docs
    runs-on: ubuntu-latest

    strategy:
      matrix:
        project:
          - projects/01-ha-web-app/terraform
          - projects/02-serverless-pipeline/terraform
          - projects/03-landing-zone/terraform
          - projects/04-eks-application-deployment/terraform
          - projects/05-hybrid-cloud-architecture/terraform
          - projects/06-data-lake/terraform

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # This step BOTH runs terraform-docs and writes a file for you.
      - name: Run terraform-docs for ${{ matrix.project }}
        uses: terraform-docs/gh-actions@v1.0.0
        with:
          # directory containing the .tf files
          working-dir: ${{ matrix.project }}
          # write output into this file relative to working-dir
          output-file: .tfdocs.md
          # write to file instead of injecting into README
          output-method: file
          # optional, but keeps it simple: markdown table format
          args: "markdown table ."

      # Collect all generated docs as an artifact (optional but nice)
      - name: Upload terraform-docs artifacts
        if: matrix.project == 'projects/06-data-lake/terraform'
        uses: actions/upload-artifact@v4
        with:
          name: terraform-docs
          path: |
            projects/**/.tfdocs.md
